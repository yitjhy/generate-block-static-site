            },
            "min": {
              "type": "number",
              "description": "最小值。"
            },
            "max": {
              "type": "number",
              "description": "最大值。"
            }
          },
          "required": ["value"],
          "anyOf": [
            {
              "required": ["min"]
            },
            {
              "required": ["max"]
            }
          ],
          "additionalProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "email": {
      "type": "object",
      "description": "是否合法邮箱。",
      "properties": {
        "call": {
          "const": "email"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/DynamicString"
            }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "and": {
      "type": "object",
      "description": "逻辑与。",
      "properties": {
        "call": {
          "const": "and"
        },
        "args": {
          "type": "object",
          "properties": {
            "values": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/DynamicBoolean"
              }
            }
          },
          "required": ["values"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "or": {
      "type": "object",
      "description": "逻辑或。",
      "properties": {
        "call": {
          "const": "or"
        },
        "args": {
          "type": "object",
          "properties": {
            "values": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/DynamicBoolean"
              }
            }
          },
          "required": ["values"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "not": {
      "type": "object",
      "description": "逻辑非。",
      "properties": {
        "call": {
          "const": "not"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/DynamicBoolean"
            }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "eq": {
      "type": "object",
      "description": "严格相等（扩展函数）。",
      "properties": {
        "call": {
          "const": "eq"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "description": "要比较的值。"
            },
            "equals": {
              "description": "比较目标字面量。"
            }
          },
          "required": ["value", "equals"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "contains": {
      "type": "object",
      "description": "数组是否包含某项（扩展函数）。",
      "properties": {
        "call": {
          "const": "contains"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "description": "要搜索的数组。"
            },
            "item": {
              "description": "要查找的项。"
            }
          },
          "required": ["value", "item"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "formatNumber": {
      "type": "object",
      "description": "数字格式化。",
      "properties": {
        "call": {
          "const": "formatNumber"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/DynamicNumber",
              "description": "要格式化的数字。"
            },
            "decimals": {
              "$ref": "#/$defs/DynamicNumber",
              "description": "小数位数。"
            },
            "grouping": {
              "$ref": "#/$defs/DynamicBoolean",
              "description": "是否千分位。"
            }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "string"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "formatCurrency": {
      "type": "object",
      "description": "货币格式化。",
      "properties": {
        "call": {
          "const": "formatCurrency"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/DynamicNumber",
              "description": "金额。"
            },
            "currency": {
              "$ref": "#/$defs/DynamicString",
              "description": "ISO 4217 货币码。"
            },
            "decimals": {
              "$ref": "#/$defs/DynamicNumber"
            },
            "grouping": {
              "$ref": "#/$defs/DynamicBoolean"
            }
          },
          "required": ["currency", "value"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "string"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "formatDate": {
      "type": "object",
      "description": "用模式串格式化日期。",
      "properties": {
        "call": {
          "const": "formatDate"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/DynamicValue",
              "description": "要格式化的日期。"
            },
            "format": {
              "$ref": "#/$defs/DynamicString",
              "description": "Unicode TR35 模式串（如 yyyy-MM-dd、HH:mm）。"
            }
          },
          "required": ["format", "value"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "string"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "pluralize": {
      "type": "object",
      "description": "按 CLDR 复数类别返回字符串，需提供 other 兜底。",
      "properties": {
        "call": {
          "const": "pluralize"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/DynamicNumber",
              "description": "决定复数类别的数值。"
            },
            "zero": {
              "$ref": "#/$defs/DynamicString"
            },
            "one": {
              "$ref": "#/$defs/DynamicString"
            },
            "two": {
              "$ref": "#/$defs/DynamicString"
            },
            "few": {
              "$ref": "#/$defs/DynamicString"
            },
            "many": {
              "$ref": "#/$defs/DynamicString"
            },
            "other": {
              "$ref": "#/$defs/DynamicString",
              "description": "兜底字符串。"
            }
          },
          "required": ["value", "other"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "string"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "formatString": {
      "type": "object",
      "description": "字符串插值，支持 ${/path} 与 ${fn(args)} 表达式。",
      "properties": {
        "call": {
          "const": "formatString"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/DynamicString"
            }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "string"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "openUrl": {
      "type": "object",
      "description": "在新标签打开 URL（无返回值）。",
      "properties": {
        "call": {
          "const": "openUrl"
        },
        "args": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri",
              "description": "要打开的 URL。"
            }
          },
          "required": ["url"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "void"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    }
  },
  "$defs": {
    "ComponentCommon": {
      "type": "object",
      "description": "所有组件的公共字段。",
      "properties": {
        "id": {
          "$ref": "#/$defs/ComponentId"
        },
        "accessibility": {
          "$ref": "#/$defs/AccessibilityAttributes"
        }
      },
      "required": ["id"]
    },
    "theme": {
      "type": "object",
      "description": "surface 主题参数。",
      "properties": {
        "primaryColor": {
          "type": "string",
          "description": "品牌主色（十六进制）。",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "iconUrl": {
          "type": "string",
          "format": "uri",
          "description": "Agent/工具标识图。"
        },
        "agentDisplayName": {
          "type": "string",
          "description": "Agent/工具展示名。"
        }
      },
      "additionalProperties": true
    },
    "AccessibilityAttributes": {
      "type": "object",
      "description": "无障碍属性。本渲染器仅实现 hidden 条件显隐；label/description 未实现，故不收录。",
      "properties": {
        "hidden": {
          "$ref": "#/$defs/DynamicBoolean",
          "description": "为 true 时渲染器不渲染该组件（条件显隐）。本渲染器支持。"
        }
      }
    },
    "ComponentId": {
      "type": "string",
      "description": "同一 surface 内的组件唯一 id。"
    },
    "ChildList": {
      "description": "子组件引用列表。注意：本渲染器（@ant-design/x-card 2.9.0）仅支持静态数组形式，不支持模板迭代；模板形式仅为规范完整性保留。",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComponentId"
          },
          "description": "静态子组件 id 列表。"
        },
        {
          "type": "object",
          "description": "（规范保留）从数据模型列表生成子组件的模板；当前渲染器不支持。",
          "properties": {
            "componentId": {
              "$ref": "#/$defs/ComponentId"
            },
            "path": {
              "type": "string",
              "description": "数据模型中组件属性对象列表的路径。"
            }
          },
          "required": ["componentId", "path"],
          "additionalProperties": false
        }
      ]
    },
    "Option": {
      "type": "object",
      "description": "可选项。",
      "properties": {
        "label": {
          "$ref": "#/$defs/DynamicString"
        },
        "value": {
          "type": "string"
        }
      },
      "required": ["label", "value"],
      "additionalProperties": false
    },
    "DataBinding": {
      "type": "object",
      "description": "数据绑定：JSON Pointer 路径。以 / 开头为绝对路径，否则相对当前作用域。",
      "properties": {
        "path": {
          "type": "string"
        }
      },
      "required": ["path"],
      "additionalProperties": false
    },
    "DynamicValue": {
      "description": "字面量 | 数据绑定 | 任意返回类型的函数调用。",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "array"
        },
        {
          "$ref": "#/$defs/DataBinding"
        },
        {
          "$ref": "#/$defs/FunctionCall"
        }
      ]
    },
    "DynamicString": {
      "description": "字符串 | 数据绑定 | 返回 string 的函数调用。",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/DataBinding"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/FunctionCall"
            },
            {
              "properties": {
                "returnType": {
                  "const": "string"
                }
              }
            }
          ]
        }
      ]
    },
    "DynamicNumber": {
      "description": "数值 | 数据绑定 | 返回 number 的函数调用。",
      "oneOf": [
        {
          "type": "number"
        },
        {
          "$ref": "#/$defs/DataBinding"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/FunctionCall"
            },
            {
              "properties": {
                "returnType": {
                  "const": "number"
                }
              }
            }
          ]
        }
      ]
    },
    "DynamicBoolean": {
      "description": "布尔 | 数据绑定 | 返回 boolean 的函数调用。",
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/DataBinding"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/FunctionCall"
            },
            {
              "properties": {
                "returnType": {
                  "const": "boolean"
                }
              }
            }
          ]
        }
      ]
    },
    "DynamicStringList": {
      "description": "字符串数组 | 数据绑定 | 返回 array 的函数调用。",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "$ref": "#/$defs/DataBinding"
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/FunctionCall"
            },
            {
              "properties": {
                "returnType": {
                  "const": "array"
                }
              }
            }
          ]
        }
      ]
    },
    "FunctionCall": {
      "type": "object",
      "description": "客户端函数调用。",
      "properties": {
        "call": {
          "type": "string",
          "description": "函数名。"
        },
        "args": {
          "type": "object",
          "description": "函数参数。",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/DynamicValue"
              },
              {
                "type": "object",
                "description": "字面对象参数（如配置）。"
              }
            ]
          }
        },
        "returnType": {
          "type": "string",
          "description": "期望返回类型。",
          "enum": ["string", "number", "boolean", "array", "object", "any", "void"],
          "default": "boolean"
        }
      },
      "required": ["call"],
      "oneOf": [
        {
          "$ref": "#/$defs/anyFunction"
        }
      ]
    },
    "CheckRule": {
      "type": "object",
      "description": "单条校验规则：condition 为假时展示 message。",
      "properties": {
        "condition": {
          "$ref": "#/$defs/DynamicBoolean"
        },
        "message": {
          "type": "string",
          "description": "校验失败时的提示。"
        }
      },
      "required": ["condition", "message"],
      "additionalProperties": false
    },
    "Checkable": {
      "type": "object",
      "description": "支持客户端校验的组件公共字段。",
      "properties": {
        "checks": {
          "type": "array",
          "description": "校验规则列表（函数调用，返回 boolean 表示是否有效）。",
          "items": {
            "$ref": "#/$defs/CheckRule"
          }
        }
      }
    },
    "Action": {
      "description": "交互声明：event 回传服务端；functionCall 客户端本地执行。",
      "oneOf": [
        {
          "type": "object",
          "description": "触发服务端事件。",
          "properties": {
            "event": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "description": "事件名。"
                },
                "context": {
                  "type": "object",
                  "description": "事件上下文，值可为字面量或路径绑定。路径在此表示写入目标。",
                  "additionalProperties": {
                    "$ref": "#/$defs/DynamicValue"
                  }
                }
              },
              "required": ["name"],
              "additionalProperties": false
            }
          },
          "required": ["event"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "执行本地客户端函数。",
          "properties": {
            "functionCall": {
              "$ref": "#/$defs/FunctionCall"
            }
          },
          "required": ["functionCall"],
          "additionalProperties": false
        }
      ]
    },
    "anyComponent": {
      "description": "任意组件的联合（按 component 字段判别）。",
      "oneOf": [
        {
          "$ref": "#/components/Text"
        },
        {
          "$ref": "#/components/Image"
        },
        {
          "$ref": "#/components/Icon"
        },
        {
          "$ref": "#/components/Video"
        },
        {
          "$ref": "#/components/AudioPlayer"
        },
        {
          "$ref": "#/components/Row"
        },
        {
          "$ref": "#/components/Column"
        },
        {
          "$ref": "#/components/List"
        },
        {
          "$ref": "#/components/Card"
        },
        {
          "$ref": "#/components/Tabs"
        },
        {
          "$ref": "#/components/Modal"
        },
        {
          "$ref": "#/components/Divider"
        },
        {
          "$ref": "#/components/Button"
        },
        {
          "$ref": "#/components/TextField"
        },
        {
          "$ref": "#/components/CheckBox"
        },
        {
          "$ref": "#/components/ChoicePicker"
        },
        {
          "$ref": "#/components/Select"
        },
        {
          "$ref": "#/components/CountrySelect"
        },
        {
          "$ref": "#/components/LanguageSelect"
        },
        {
          "$ref": "#/components/Slider"
        },
        {
          "$ref": "#/components/DateTimeInput"
        },
        {
          "$ref": "#/components/SwitchField"
        }
      ],
      "discriminator": {
        "propertyName": "component"
      }
    },
    "anyFunction": {
      "description": "任意客户端函数的联合。",
      "oneOf": [
        {
          "$ref": "#/functions/required"
        },
        {
          "$ref": "#/functions/regex"
        },
        {
          "$ref": "#/functions/length"
        },
        {
          "$ref": "#/functions/numeric"
        },
        {
          "$ref": "#/functions/email"
        },
        {
          "$ref": "#/functions/and"
        },
        {
          "$ref": "#/functions/or"
        },
        {
          "$ref": "#/functions/not"
        },
        {
          "$ref": "#/functions/eq"
        },
        {
          "$ref": "#/functions/contains"
        },
        {
          "$ref": "#/functions/formatNumber"
        },
        {
          "$ref": "#/functions/formatCurrency"
        },
        {
          "$ref": "#/functions/formatDate"
        },
        {
          "$ref": "#/functions/pluralize"
        },
        {
          "$ref": "#/functions/formatString"
        },
        {
          "$ref": "#/functions/openUrl"
        }
      ]
    },
    "anyCommand": {
      "description": "服务端→客户端命令信封（A2UI v0.9）。每条命令必须携带 version:'v0.9'。",
      "oneOf": [
        {
          "type": "object",
          "description": "创建 surface。",
          "properties": {
            "version": { "const": "v0.9" },
            "createSurface": {
              "type": "object",
              "properties": {
                "surfaceId": { "type": "string" },
                "catalogId": { "type": "string", "description": "catalog 标识（本地 local://... 或远程 URL）。" },
                "theme": { "$ref": "#/$defs/theme", "description": "主题参数（x-card 2.9.0 未应用）。" },
                "sendDataModel": { "type": "boolean", "description": "action 时是否回传完整数据模型（x-card 2.9.0 未实现）。" }
              },
              "required": ["surfaceId", "catalogId"],
              "additionalProperties": false
            }
          },
          "required": ["version", "createSurface"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "更新/合并 surface 上的组件（邻接表，按 id 合并）。",
          "properties": {
            "version": { "const": "v0.9" },
            "updateComponents": {
              "type": "object",
              "properties": {
                "surfaceId": { "type": "string" },
                "components": {
                  "type": "array",
                  "description": "组件列表。约束：至少 1 项；第 0 项 id 必须为 'root'；且整个数组恰好有且仅有一个 id 为 'root'。",
                  "minItems": 1,
                  "prefixItems": [
                    {
                      "allOf": [
                        { "properties": { "id": { "const": "root" } }, "required": ["id"] },
                        { "$ref": "#/$defs/anyComponent" }
                      ]
                    }
                  ],
                  "items": { "$ref": "#/$defs/anyComponent" },
                  "contains": { "properties": { "id": { "const": "root" } }, "required": ["id"] },
                  "minContains": 1,
                  "maxContains": 1
                }
              },
              "required": ["surfaceId", "components"],
              "additionalProperties": false
            }
          },
          "required": ["version", "updateComponents"],
          "additionalProperties": false
        },
        {
          "type": "object",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local://a2ui-x-card-demo.json",
  "title": "A2UI X-Card Demo Catalog (Spec)",
  "description": "对齐 A2UI v0.9 catalog 结构的完整版：组件用 allOf 组合 ComponentCommon/Checkable，含 component 判别字段、unevaluatedProperties、anyComponent/anyFunction/discriminator、完整函数 schema 与 theme。属性严格按本渲染器（@ant-design/x-card）实际实现收敛：仅保留组件真正读取的属性（accessibility 仅 hidden，不含 label/description；无 weight），含扩展组件（Select/SwitchField）与本地约定（fieldPath、Button.text、Tabs.titles+children、Modal.children）。用于驱动 Agent 生成合法 A2UI 指令。",
  "catalogId": "local://a2ui-x-card-demo.json",
  "components": {
    "Text": {
      "type": "object",
      "description": "文本展示，支持基础 Markdown（加粗/斜体/删除线/行内代码/列表/引用/标题/表格，不含链接与图片）。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Text"
            },
            "text": {
              "$ref": "#/$defs/DynamicString",
              "description": "要展示的文本。"
            },
            "variant": {
              "type": "string",
              "description": "文本样式。",
              "enum": ["h1", "h2", "h3", "h4", "h5", "caption", "body"],
              "default": "body"
            }
          },
          "required": ["component", "text"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Image": {
      "type": "object",
      "description": "图片展示。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Image"
            },
            "url": {
              "$ref": "#/$defs/DynamicString",
              "description": "图片地址。"
            },
            "description": {
              "$ref": "#/$defs/DynamicString",
              "description": "无障碍描述。"
            },
            "fit": {
              "type": "string",
              "description": "对应 CSS object-fit。",
              "enum": ["contain", "cover", "fill", "none", "scaleDown"],
              "default": "fill"
            }
          },
          "required": ["component", "url"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Icon": {
      "type": "object",
      "description": "图标（Material 风格内置图标名，或用 svgPath 自定义）。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Icon"
            },
            "name": {
              "description": "内置图标名枚举，或 { svgPath }，或数据绑定。",
              "oneOf": [
                {
                  "type": "string",
                  "enum": [
                    "accountCircle",
                    "add",
                    "arrowBack",
                    "arrowForward",
                    "attachFile",
                    "calendarToday",
                    "call",
                    "camera",
                    "check",
                    "close",
                    "delete",
                    "download",
                    "edit",
                    "event",
                    "error",
                    "fastForward",
                    "favorite",
                    "favoriteOff",
                    "folder",
                    "help",
                    "home",
                    "info",
                    "locationOn",
                    "lock",
                    "lockOpen",
                    "mail",
                    "menu",
                    "moreVert",
                    "moreHoriz",
                    "notificationsOff",
                    "notifications",
                    "pause",
                    "payment",
                    "person",
                    "phone",
                    "photo",
                    "play",
                    "print",
                    "refresh",
                    "rewind",
                    "search",
                    "send",
                    "settings",
                    "share",
                    "shoppingCart",
                    "skipNext",
                    "skipPrevious",
                    "star",
                    "starHalf",
                    "starOff",
                    "stop",
                    "upload",
                    "visibility",
                    "visibilityOff",
                    "volumeDown",
                    "volumeMute",
                    "volumeOff",
                    "volumeUp",
                    "warning"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "svgPath": {
                      "type": "string"
                    }
                  },
                  "required": ["svgPath"],
                  "additionalProperties": false
                },
                {
                  "$ref": "#/$defs/DataBinding"
                }
              ]
            }
          },
          "required": ["component", "name"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Video": {
      "type": "object",
      "description": "视频播放。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Video"
            },
            "url": {
              "$ref": "#/$defs/DynamicString",
              "description": "视频地址。"
            }
          },
          "required": ["component", "url"]
        }
      ],
      "unevaluatedProperties": false
    },
    "AudioPlayer": {
      "type": "object",
      "description": "音频播放。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "AudioPlayer"
            },
            "url": {
              "$ref": "#/$defs/DynamicString",
              "description": "音频地址。"
            },
            "description": {
              "$ref": "#/$defs/DynamicString",
              "description": "音频描述。"
            }
          },
          "required": ["component", "url"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Row": {
      "type": "object",
      "description": "水平布局容器。子组件用 id 引用，不能内联。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Row"
            },
            "children": {
              "$ref": "#/$defs/ChildList",
              "description": "子组件 id 列表。"
            },
            "justify": {
              "type": "string",
              "enum": ["start", "center", "end", "spaceBetween", "spaceAround", "spaceEvenly"],
              "default": "start"
            }
          },
          "required": ["component", "children"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Column": {
      "type": "object",
      "description": "垂直布局容器。子组件用 id 引用，不能内联。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Column"
            },
            "children": {
              "$ref": "#/$defs/ChildList",
              "description": "子组件 id 列表。"
            }
          },
          "required": ["component", "children"]
        }
      ],
      "unevaluatedProperties": false
    },
    "List": {
      "type": "object",
      "description": "列表容器。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "List"
            },
            "children": {
              "$ref": "#/$defs/ChildList"
            },
            "direction": {
              "type": "string",
              "enum": ["vertical", "horizontal"],
              "default": "vertical"
            },
            "align": {
              "type": "string",
              "enum": ["start", "center", "end", "stretch"],
              "default": "stretch"
            }
          },
          "required": ["component", "children"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Card": {
      "type": "object",
      "description": "卡片容器，包裹单个子组件。多个元素需先用 Column/Row 包起来再传入 id。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Card"
            },
            "child": {
              "$ref": "#/$defs/ComponentId",
              "description": "唯一子组件 id。"
            }
          },
          "required": ["component", "child"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Tabs": {
      "type": "object",
      "description": "标签页容器。本渲染器约定（非标准）：titles 为标签标题数组，children 为各标签对应的子组件 id 数组，按顺序一一对应。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Tabs"
            },
            "titles": {
              "type": "array",
              "description": "标签标题列表。",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/DynamicString"
              }
            },
            "children": {
              "description": "各标签对应的子组件 id 列表，顺序与 titles 对应。",
              "$ref": "#/$defs/ChildList"
            }
          },
          "required": ["component", "titles", "children"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Modal": {
      "type": "object",
      "description": "弹窗容器。本渲染器约定（非标准）：children[0] 为触发器（点击打开），children[1] 为弹窗内容。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Modal"
            },
            "children": {
              "type": "array",
              "description": "[triggerId, contentId]，恰好 2 项。",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "$ref": "#/$defs/ComponentId"
              }
            }
          },
          "required": ["component", "children"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Divider": {
      "type": "object",
      "description": "分割线。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Divider"
            },
            "axis": {
              "type": "string",
              "enum": ["horizontal", "vertical"],
              "default": "horizontal"
            }
          },
          "required": ["component"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Button": {
      "type": "object",
      "description": "按钮。本渲染器约定（非标准）：用 text 直接渲染文案（标准 protocol 用 child 引用 Text/Icon）。action 触发服务端事件或客户端函数。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Button"
            },
            "text": {
              "$ref": "#/$defs/DynamicString",
              "description": "按钮文案。"
            },
            "variant": {
              "type": "string",
              "description": "按钮样式。primary 为主操作，borderless 无边框。",
              "enum": ["default", "primary", "borderless"],
              "default": "default"
            },
            "action": {
              "$ref": "#/$defs/Action"
            }
          },
          "required": ["component", "text", "action"]
        }
      ],
      "unevaluatedProperties": false
    },
    "TextField": {
      "type": "object",
      "description": "文本输入框，双向绑定。fieldPath 为本渲染器扩展：写回数据模型的路径（不含前导 /）。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "TextField"
            },
            "label": {
              "$ref": "#/$defs/DynamicString",
              "description": "字段标签。"
            },
            "value": {
              "$ref": "#/$defs/DynamicString",
              "description": "值。"
            },
            "fieldPath": {
              "type": "string",
              "description": "写回路径（不含前导 /，如 form/name）。"
            },
            "variant": {
              "type": "string",
              "description": "输入类型。",
              "enum": ["longText", "number", "shortText", "obscured"],
              "default": "shortText"
            },
            "placeholder": {
              "$ref": "#/$defs/DynamicString",
              "description": "占位文本。"
            }
          },
          "required": ["component", "label", "fieldPath"]
        }
      ],
      "unevaluatedProperties": false
    },
    "CheckBox": {
      "type": "object",
      "description": "复选框，双向绑定布尔值。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "CheckBox"
            },
            "label": {
              "$ref": "#/$defs/DynamicString",
              "description": "复选框文本。"
            },
            "value": {
              "$ref": "#/$defs/DynamicBoolean",
              "description": "当前状态。"
            },
            "fieldPath": {
              "type": "string",
              "description": "写回路径（不含前导 /）。"
            }
          },
          "required": ["component", "label", "value", "fieldPath"]
        }
      ],
      "unevaluatedProperties": false
    },
    "ChoicePicker": {
      "type": "object",
      "description": "单选或多选。value 始终是数组。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "ChoicePicker"
            },
            "label": {
              "$ref": "#/$defs/DynamicString",
              "description": "选项组标签。"
            },
            "variant": {
              "type": "string",
              "description": "单选或多选。",
              "enum": ["mutuallyExclusive", "multipleSelection"],
              "default": "mutuallyExclusive"
            },
            "options": {
              "type": "array",
              "description": "可选项。",
              "items": {
                "$ref": "#/$defs/Option"
              }
            },
            "value": {
              "$ref": "#/$defs/DynamicStringList",
              "description": "当前选中值数组。"
            },
            "direction": {
              "type": "string",
              "description": "排列方向。",
              "enum": ["vertical", "horizontal"],
              "default": "horizontal"
            },
            "fieldPath": {
              "type": "string",
              "description": "写回路径（不含前导 /）。"
            }
          },
          "required": ["component", "options", "value", "fieldPath"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Select": {
      "type": "object",
      "description": "下拉选择（本渲染器扩展组件）。value 始终是数组。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Select"
            },
            "label": {
              "$ref": "#/$defs/DynamicString",
              "description": "标签。"
            },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Option"
              }
            },
            "value": {
              "$ref": "#/$defs/DynamicStringList"
            },
            "multiple": {
              "type": "boolean",
              "description": "是否多选。",
              "default": false
            },
            "placeholder": {
              "$ref": "#/$defs/DynamicString"
            },
            "fieldPath": {
              "type": "string",
              "description": "写回路径（不含前导 /）。"
            }
          },
          "required": ["component", "options", "value", "fieldPath"]
        }
      ],
      "unevaluatedProperties": false
    },
    "CountrySelect": {
      "type": "object",
      "description": "国家/地区下拉（本渲染器扩展组件，选项内置自 country-region-data，共 249 项）。value 始终是国家名数组。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "CountrySelect"
            },
            "label": {
              "$ref": "#/$defs/DynamicString",
              "description": "标签。"
            },
            "value": {
              "$ref": "#/$defs/DynamicStringList",
              "description": "选中的国家名数组（如 [\"China\"]）。"
            },
            "fieldPath": {
              "type": "string",
              "description": "写回路径（不含前导 /）。"
            },
            "multiple": {
              "type": "boolean",
              "description": "是否多选。",
              "default": false
            },
            "placeholder": {
              "$ref": "#/$defs/DynamicString"
            }
          },
          "required": ["component", "fieldPath"]
        }
      ],
      "unevaluatedProperties": false
    },
    "LanguageSelect": {
      "type": "object",
      "description": "语言下拉（本渲染器扩展组件，选项来自 getLanguageList API）。value 始终是语言代码（string）数组。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "LanguageSelect"
            },
            "label": {
              "$ref": "#/$defs/DynamicString",
              "description": "标签。"
            },
            "options": {
              "type": "array",
              "description": "可选语言项；省略时用组件内置默认语言列表。",
              "items": {
                "$ref": "#/$defs/Option"
              }
            },
            "value": {
              "$ref": "#/$defs/DynamicStringList",
              "description": "选中的语言代码数组（如 [\"en\"]）。"
            },
            "fieldPath": {
              "type": "string",
              "description": "写回路径（不含前导 /）。"
            },
            "multiple": {
              "type": "boolean",
              "description": "是否多选。",
              "default": false
            },
            "placeholder": {
              "$ref": "#/$defs/DynamicString"
            }
          },
          "required": ["component", "fieldPath"]
        }
      ],
      "unevaluatedProperties": false
    },
    "Slider": {
      "type": "object",
      "description": "滑块，双向绑定数值。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "Slider"
            },
            "label": {
              "$ref": "#/$defs/DynamicString"
            },
            "min": {
              "type": "number",
              "description": "最小值。",
              "default": 0
            },
            "max": {
              "type": "number",
              "description": "最大值。"
            },
            "value": {
              "$ref": "#/$defs/DynamicNumber"
            },
            "fieldPath": {
              "type": "string",
              "description": "写回路径（不含前导 /）。"
            }
          },
          "required": ["component", "value", "max", "fieldPath"]
        }
      ],
      "unevaluatedProperties": false
    },
    "DateTimeInput": {
      "type": "object",
      "description": "日期/时间输入，值为 ISO 8601 字符串。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "$ref": "#/$defs/Checkable"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "DateTimeInput"
            },
            "value": {
              "$ref": "#/$defs/DynamicString",
              "description": "ISO 8601 值，未设置时为空字符串。"
            },
            "enableDate": {
              "type": "boolean",
              "description": "允许选择日期。",
              "default": false
            },
            "enableTime": {
              "type": "boolean",
              "description": "允许选择时间。",
              "default": false
            },
            "label": {
              "$ref": "#/$defs/DynamicString"
            },
            "fieldPath": {
              "type": "string",
              "description": "写回路径（不含前导 /）。"
            }
          },
          "required": ["component", "value", "fieldPath"]
        }
      ],
      "unevaluatedProperties": false
    },
    "SwitchField": {
      "type": "object",
      "description": "开关，双向绑定布尔值（本渲染器扩展组件）。",
      "allOf": [
        {
          "$ref": "#/$defs/ComponentCommon"
        },
        {
          "type": "object",
          "properties": {
            "component": {
              "const": "SwitchField"
            },
            "label": {
              "$ref": "#/$defs/DynamicString"
            },
            "value": {
              "$ref": "#/$defs/DynamicBoolean"
            },
            "fieldPath": {
              "type": "string",
              "description": "写回路径（不含前导 /）。"
            }
          },
          "required": ["component", "label", "fieldPath"]
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "functions": {
    "required": {
      "type": "object",
      "description": "值非 null、undefined 或空。",
      "properties": {
        "call": {
          "const": "required"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "description": "要检查的值。"
            }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "regex": {
      "type": "object",
      "description": "值匹配正则。",
      "properties": {
        "call": {
          "const": "regex"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/DynamicString"
            },
            "pattern": {
              "type": "string",
              "description": "正则表达式。"
            }
          },
          "required": ["value", "pattern"],
          "additionalProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "length": {
      "type": "object",
      "description": "字符串长度约束。",
      "properties": {
        "call": {
          "const": "length"
        },
        "args": {
          "type": "object",
          "properties": {
            "value": {
              "$ref": "#/$defs/DynamicString"
            },
            "min": {
              "type": "integer",
              "minimum": 0,
              "description": "最小长度。"
            },
            "max": {
              "type": "integer",
              "minimum": 0,
              "description": "最大长度。"
            }
          },
          "required": ["value"],
          "anyOf": [
            {
              "required": ["min"]
            },
            {
              "required": ["max"]
            }
          ],
          "additionalProperties": false
        },
        "returnType": {
          "const": "boolean"
        }
      },
      "required": ["call", "args"],
      "unevaluatedProperties": false
    },
    "numeric": {
      "type": "object",
